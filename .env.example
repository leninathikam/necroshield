# Local examples only. Never use production credentials in the arena.
# Without DATABASE_URL, the backend uses a local SQLite file.
# DATABASE_URL=postgresql+psycopg://necroshield:replace-with-local-password@127.0.0.1:5432/necroshield
# Set a local password before starting the optional Compose database.
POSTGRES_PASSWORD=replace-with-local-password
BACKEND_URL=http://127.0.0.1:8017
NECROSHIELD_FRONTEND_ORIGIN=http://127.0.0.1:3017
